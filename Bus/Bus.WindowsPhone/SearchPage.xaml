<Page
    x:Class="HKBusWP.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HKBusWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Pivot Category Selector (Tram split between Railway and Ferry) -->
        <Pivot x:Name="CategoryPivot"
               Grid.Row="0"
               Margin="0,18,0,0"
               SelectionChanged="CategoryPivot_SelectionChanged">
            <PivotItem x:Name="PivotRecent" Header="最近搜尋" Margin="0"/>
            <PivotItem x:Name="PivotAll" Header="全部" Margin="0"/>
            <PivotItem x:Name="PivotBus" Header="巴士" Margin="0"/>
            <PivotItem x:Name="PivotMinibus" Header="小巴" Margin="0"/>
            <PivotItem x:Name="PivotRailway" Header="鐵路" Margin="0"/>
            <PivotItem x:Name="PivotTram" Header="電車" Margin="0"/>
            <PivotItem x:Name="PivotFerry" Header="渡輪" Margin="0"/>
        </Pivot>

        <Border Grid.Row="1"
                Background="#18888888"
                Padding="16,6,16,6"
                BorderBrush="#33888888"
                BorderThickness="0,1,0,1"
                ManipulationMode="TranslateX,System"
                ManipulationCompleted="SearchArea_ManipulationCompleted">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchPrefixLabel"
                           Grid.Column="0"
                           Text="搜尋路線: "
                           FontSize="15"
                           Opacity="0.75"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchQueryText"
                           Grid.Column="1"
                           Text="全部路線"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
                <TextBlock x:Name="ResultCountText"
                           Grid.Column="2"
                           Text="正在載入..."
                           FontSize="13"
                           Opacity="0.65"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ListView x:Name="SearchResultsListView"
                  Grid.Row="2"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ManipulationMode="TranslateX,System"
                  ManipulationCompleted="SearchArea_ManipulationCompleted"
                  ItemClick="SearchResultsListView_ItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#33888888"
                            BorderThickness="0,0,0,1"
                            Padding="16,10,16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="{Binding RouteNumber}"
                                         FontSize="27"
                                         FontWeight="SemiBold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding SpecialNote}"
                                         FontSize="12"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Company}"
                                           FontSize="13"
                                           Opacity="0.65"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ToPrefixText}" FontSize="15"/>
                                    <Run Text="{Binding Destination}"
                                         FontSize="21"
                                         FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="14"
                                           Opacity="0.75"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Origin}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding FareText}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="KeypadContainerGrid"
              Grid.Row="3"
              Background="#E6B800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="38*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="4,4,2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="NumBtn1" Grid.Row="0" Grid.Column="0" Content="1" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>
                <Button x:Name="NumBtn2" Grid.Row="0" Grid.Column="1" Content="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>
                <Button x:Name="NumBtn3" Grid.Row="0" Grid.Column="2" Content="3" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>

                <Button x:Name="NumBtn4" Grid.Row="1" Grid.Column="0" Content="4" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>
                <Button x:Name="NumBtn5" Grid.Row="1" Grid.Column="1" Content="5" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>
                <Button x:Name="NumBtn6" Grid.Row="1" Grid.Column="2" Content="6" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>

                <Button x:Name="NumBtn7" Grid.Row="2" Grid.Column="0" Content="7" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>
                <Button x:Name="NumBtn8" Grid.Row="2" Grid.Column="1" Content="8" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>
                <Button x:Name="NumBtn9" Grid.Row="2" Grid.Column="2" Content="9" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="40" MinHeight="42" FontSize="24" FontWeight="SemiBold" BorderThickness="0" Click="KeypadKey_Click"/>

                <Button x:Name="ClearKeyBtn"
                        Grid.Row="3" Grid.Column="0"
                        Content="⊖"
                        FontSize="22"
                        Margin="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MinWidth="40" MinHeight="42"
                        BorderThickness="0"
                        Click="ClearKey_Click"/>

                <Button x:Name="NumBtn0"
                        Grid.Row="3" Grid.Column="1"
                        Content="0"
                        Margin="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MinWidth="40" MinHeight="42"
                        FontSize="24"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="KeypadKey_Click"/>

                <Button x:Name="BackspaceKeyBtn"
                        Grid.Row="3" Grid.Column="2"
                        Content="⌫"
                        FontSize="22"
                        Margin="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MinWidth="40" MinHeight="42"
                        BorderThickness="0"
                        Click="BackspaceKey_Click"/>
            </Grid>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="2,4,4,4">
                <Grid x:Name="DynamicLettersGrid" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>