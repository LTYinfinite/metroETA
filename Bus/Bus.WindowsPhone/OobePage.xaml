<Page
    x:Class="HKBusWP.OobePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HKBusWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20,28,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="OobeTitleText"
                       Text="歡迎使用 MetroETA"
                       FontSize="34"
                       FontWeight="Bold"/>
            <TextBlock x:Name="OobeSubTitleText"
                       Text="初次啟動設定（稍後可於設定中隨時更改）："
                       FontSize="14"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">

                <!-- 1. Language Selection List -->
                <Border BorderBrush="#33888888"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LangHeaderText"
                                   Text="1. 介面語言 / language"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="LangComboBox"
                                  HorizontalAlignment="Stretch"
                                  FontSize="17"
                                  SelectionChanged="LangComboBox_SelectionChanged">
                            <ComboBoxItem Content="繁體中文"/>
                            <ComboBoxItem Content="english"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 2. Theme Selection -->
                <Border BorderBrush="#33888888"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="ThemeHeaderText"
                                   Text="2. 外觀主題"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <RadioButton x:Name="LightRadio"
                                     Content="淺色主題 (白底黑字)"
                                     FontSize="17"
                                     Margin="0,0,0,8"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="DarkRadio"
                                     Content="深色主題 (黑底白字 / 省電)"
                                     FontSize="17"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>
                </Border>

                <!-- 3. Search Radius Slider -->
                <Border BorderBrush="#33888888"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="RadiusHeaderText"
                                   Text="3. 附近路線搜尋半徑 (50m - 500m)"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="OobeRadiusValueText"
                                   Text="目前搜尋半徑: 250 米"
                                   FontSize="15"
                                   Foreground="#1976D2"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <Slider x:Name="OobeRadiusSlider"
                                Minimum="50"
                                Maximum="500"
                                StepFrequency="50"
                                TickFrequency="50"
                                Value="250"
                                ValueChanged="OobeRadiusSlider_ValueChanged"/>
                        <Grid Margin="0,-6,0,0">
                            <TextBlock Text="50m" FontSize="12" Opacity="0.65" HorizontalAlignment="Left"/>
                            <TextBlock Text="250m" FontSize="12" Opacity="0.65" HorizontalAlignment="Center"/>
                            <TextBlock Text="500m" FontSize="12" Opacity="0.65" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Default Starting Page Selector (7 Tabs) -->
                <Border BorderBrush="#33888888"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="StartTabHeaderText"
                                   Text="4. 預設啟動頁面"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="StartTabComboBox"
                                  HorizontalAlignment="Stretch"
                                  FontSize="17"
                                  SelectionChanged="StartTabComboBox_SelectionChanged">
                            <ComboBoxItem Content="收藏 (favourites)"/>
                            <ComboBoxItem Content="巴士 (bus)"/>
                            <ComboBoxItem Content="小巴 (minibus)"/>
                            <ComboBoxItem Content="鐵路 (railway)"/>
                            <ComboBoxItem Content="電車 (tram)"/>
                            <ComboBoxItem Content="渡輪 (ferry)"/>
                            <ComboBoxItem Content="交通消息 (traffic)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 5. Hide Stop Code Behind Stop Name -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="StopCodeHeaderText"
                               Text="5. 車站名稱顯示格式"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <CheckBox x:Name="OobeHideStopCodeCheckBox"
                              Content="隱藏車站名稱後的代碼 (如 YT615、KC400)"
                              FontSize="16"
                              Checked="OobeHideStopCodeCheckBox_Changed"
                              Unchecked="OobeHideStopCodeCheckBox_Changed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="StartButton"
                Grid.Row="2"
                Content="開始使用"
                HorizontalAlignment="Stretch"
                Height="54"
                FontSize="20"
                Click="StartButton_Click"/>
    </Grid>
</Page>